#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        back_del: back_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BACK_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        combo_caps {
            bindings = <&kp CAPS>;
            key-positions = <28 41>;
        };

        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <23 24>;
        };

        combo_leftLP {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <17 18>;
        };

        combo_leftBR {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <32 33>;
        };

        combo_leftBT {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 5>;
        };

        combo_rightPT {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <22 23>;
        };

        combo_rightBR {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <36 37>;
        };

        combo_rightBT {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;
        };

        combo_backslash {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <40 39>;
        };

        combo_pipe {
            bindings = <&kp PIPE>;
            key-positions = <40 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&mt GRAVE ESCAPE  &kp Q  &kp W  &kp E     &kp R        &kp T                             &kp UP                &kp Y      &kp U        &kp I         &kp O    &kp P     &back_del
&mt LCTRL TAB     &kp A  &kp S  &kp D     &kp F        &kp G                   &kp LEFT  &kp ENTER  &kp RIGHT  &kp H      &kp J        &kp K         &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT    &kp Z  &kp X  &kp C     &kp V        &kp B      &kp SPACE              &kp DOWN              &kp N      &kp M        &kp COMMA     &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                &kp LGUI  &lt 1 SPACE  &kp ENTER                                               &kp ENTER  &lt 2 SPACE  &kp LEFT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN    &kp POUND     &kp DOLLAR      &kp PERCENT                            &mmv MOVE_UP                     &kp N7        &kp N8        &kp N9        &kp SLASH   &kp ASTERISK  &back_del
&trans  &kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp MINUS       &kp EQUAL              &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS   &kp PLUS      &none
&trans  &kp RA(N5)       &none          &none         &kp UNDERSCORE  &kp PLUS     &trans                    &mmv MOVE_DOWN                   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp EQUAL     &none
                                        &trans        &trans          &trans                                                                  &trans        &kp N0        &kp COMMA
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "fn";
            bindings = <
&trans           &kp F1           &kp F2           &kp F3           &kp F4           &kp F5                                     &mmv MOVE_UP                     &kp F6          &kp F7          &kp F8        &kp F9           &kp F10   &kp F11
&trans           &kp RA(Q)        &kp RA(S)        &kp RA(P)        &kp RA(Y)        &kp PRINTSCREEN            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LEFT        &kp DOWN        &kp UP_ARROW  &kp RIGHT        &none     &kp F12
&rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &trans                    &mmv MOVE_DOWN                   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp MB1  &mkp MB2
                                                   &kp C_VOL_DN     &kp C_VOL_UP     &kp K_MUTE                                                                  &trans          &trans          &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
